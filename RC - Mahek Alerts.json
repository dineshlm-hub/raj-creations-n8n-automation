    {
      "id": "3d7e9645-6169-4e1e-a817-3ee1a252850a",
      "name": "Check Results",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1320,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Sent: remember it. Refused straight away (e.g. template not approved, or outside the 24 h window): send the fallback.\nconst out = [];\n$input.all().forEach((it, i) => {\n  const src = $('Plan').itemMatching(i).json;\n  const id = ((it.json.messages || [])[0] || {}).id;\n  if (id) out.push({ json: { next: 'log', wamid: id, to_phone: src.to, kind: src.kind, phone: src.phone, order_id: src.order_id, fallback: JSON.stringify(src.fallback || []), created_ms: Date.now(), retried: !!src.retry_of } });\n  else for (const p of src.fallback || []) out.push({ json: { next: 'fallback', payload: p, to: src.to, kind: p.type === 'template' ? 'template' : 'free', phone: src.phone, order_id: src.order_id, reason: JSON.stringify(it.json.error || it.json).slice(0, 300) } });\n});\nreturn out;"
      }
    },
