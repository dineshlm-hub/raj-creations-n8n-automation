        "jsCode": "return $input.all().map((it, i) => {\n  const src = $('Try Fallback?').itemMatching(i).json;\n  return { json: { wamid: ((it.json.messages || [])[0] || {}).id || '', to_phone: src.to, kind: src.kind, phone: src.phone, order_id: src.order_id, fallback: '[]', created_ms: Date.now(), retried: true } };\n}).filter((x) => x.json.wamid);"
