    {
      "id": "39fc6473-a4bc-408e-a95a-c8dc4b683b2a",
      "name": "Plan",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// How to reach Mahek: while her 24-hour WhatsApp window is open (she messaged or tapped a button in the last\n// 23.5 h) a normal message is free, instant and can carry buttons. Otherwise only an approved template gets through.\n// Every message carries a fallback: if WhatsApp rejects it now, or reports it \"failed\" later (see mode \"failed\"),\n// the fallback goes out instead.\nconst MAHEK = '919112296139';\nconst inp = $('Alert In').first().json;\nconst mode = inp.mode || 'send';\nconst tpl = {};\nfor (const it of $('Template Names').all()) if (it.json && it.json.key) tpl[it.json.key] = it.json;\nconst approved = (k) => (tpl[k] && tpl[k].status === 'APPROVED' && tpl[k].name ? tpl[k].name : '');\n\nif (mode === 'failed') {\n  // a message we sent earlier was reported as failed: send its fallback once\n  const row = $('Logged Message').first().json || {};\n  if (!row.wamid || row.retried) return [];\n  let fb = [];\n  try { fb = JSON.parse(row.fallback || '[]'); } catch (e) { fb = []; }\n  const why = (((inp.status || {}).errors || [])[0] || {});\n  return fb.map((p) => ({ json: { to: p.to, payload: p, log: true, kind: p.type === 'template' ? 'template' : 'free', phone: row.phone || '', order_id: row.order_id || '', fallback: [], retry_of: row.wamid, reason: (why.code || '') + ' ' + (why.title || '') } }));\n}\n\nlet st = {};\ntry { st = JSON.parse($('Mahek State').first().json.value || '{}') || {}; } catch (e) { st = {}; }\nconst a = inp.alert || {};\nconst phone = String(a.phone || '');\nconst name = a.name || 'Customer';\nconst windowOpen = Date.now() - (Number(st.last_in_ms) || 0) < 23.5 * 3600 * 1000;\nconst details = { messaging_product: 'whatsapp', recipient_type: 'individual', to: MAHEK, type: 'interactive', interactive: {\n  type: 'cta_url', header: { type: 'text', text: String(a.header || 'New alert').slice(0, 60) }, body: { text: String(a.body || '').slice(0, 1024) },\n  footer: { text: 'Raj Creation order assistant' }, action: { name: 'cta_url', parameters: { display_text: 'Chat with customer', url: 'https://rajcreation.info/chat/?n=' + phone } } } };\nconst btn = (id, title) => ({ type: 'reply', reply: { id, title } });\nconst bts = [];\nif (a.order_id) bts.push(btn('a:fin:' + a.order_id, '✅ Finalize order'));\nbts.push(a.paused ? btn('a:re:' + phone, '▶️ Resume bot') : btn('a:pa:' + phone, '⏸️ Pause bot'));\nbts.push(btn('a:st:' + phone, '📋 Status'));\nif (bts.length < 3) bts.push(btn('a:sheet', '📊 Leads sheet'));\nconst actions = { messaging_product: 'whatsapp', recipient_type: 'individual', to: MAHEK, type: 'interactive', interactive: {\n  type: 'button', body: { text: 'What next for *' + name + '*' + (a.order_id ? ' (order ' + a.order_id + ')' : '') + '?' + (a.paused ? '\\n⏸️ The bot is quiet for them while you handle it.' : '') }, action: { buttons: bts } } };\nconst tname = approved('alert');\nconst params = (a.tpl || []).slice(0, 4).map((t) => ({ type: 'text', text: String(t || '-').replace(/\\s+/g, ' ').slice(0, 900) || '-' }));\nwhile (params.length < 4) params.push({ type: 'text', text: '-' });\nconst template = tname ? { messaging_product: 'whatsapp', to: MAHEK, type: 'template', template: { name: tname, language: { code: 'en_US' }, components: [\n  { type: 'body', parameters: params },\n  { type: 'button', sub_type: 'quick_reply', index: '0', parameters: [{ type: 'payload', payload: a.order_id ? 'a:fin:' + a.order_id : 'a:finp:' + phone }] },\n  { type: 'button', sub_type: 'quick_reply', index: '1', parameters: [{ type: 'payload', payload: 'a:st:' + phone }] },\n  { type: 'button', sub_type: 'quick_reply', index: '2', parameters: [{ type: 'payload', payload: 'a:pa:' + phone }] },\n  { type: 'button', sub_type: 'url', index: '3', parameters: [{ type: 'text', text: phone }] },\n] } } : null;\nconst one = { to: MAHEK, phone, order_id: a.order_id || '', log: true, retry_of: '' };\nif (windowOpen || !template) {\n  return [\n    { json: Object.assign({}, one, { kind: 'free', payload: details, fallback: template ? [template] : [] }) },\n    { json: Object.assign({}, one, { kind: 'free', payload: actions, fallback: [] }) },\n  ];\n}\nreturn [{ json: Object.assign({}, one, { kind: 'template', payload: template, fallback: [details, actions] }) }];\n"
      }
    },
